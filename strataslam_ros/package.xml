<?xml version="1.0"?>
<package format="3">
  <name>strataslam_ros</name>
  <version>0.2.0</version>
  <description>ROS 2 node, launch files, example profiles and tools of strataslam.</description>
  <maintainer email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>strataslam_core</depend>
  <depend>strataslam_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>message_filters</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_srvs</depend>
  <depend>rosbag2_cpp</depend>
  <depend>pybind11</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>strataslam_tools</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>

  <!-- Optional: builds the simulator bag exporter (demo, ROS tests); the node does not need it. -->
  <test_depend>strataslam_sim</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ros2bag</test_depend>
  <test_depend>rosbag2_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
