<?xml version="1.0"?>
<package format="3">
  <name>strataslam_core</name>
  <version>0.2.0</version>
  <description>ROS-free core of strataslam: configuration, geometry, mapping and I/O.</description>
  <maintainer email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>gtsam</depend>
  <depend>libopencv-dev</depend>
  <depend>libpng-dev</depend>
  <depend>libjpeg-dev</depend>
  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
